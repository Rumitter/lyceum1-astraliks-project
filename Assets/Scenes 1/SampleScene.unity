  m_text: "\t\u0415\u0441\u0442\u044C \u0442\u0440\u0438 \u0442\u0438\u043F\u0430
    \u0434\u0430\u043D\u043D\u044B\u0445:\n\r\n\tInt - \u0446\u0435\u043B\u043E\u0435
    \u0447\u0438\u0441\u043B\u043E\r\n\tStr -\u0441\u0442\u0440\u043E\u043A\u043E\u0432\u043E\u0435\r\n\tFloat
    - \u043F\u043B\u0430\u0432\u0430\u044E\u0449\u0435\u0435\n\n\r\n\tint() - \u0434\u0430\u0451\u0442
    \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0446\u0435\u043B\u043E\u0435
    \u0447\u0438\u0441\u043B\u043E \u0432 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438,
    \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0431\u0438\u0440\u0430\u044F \u0434\u0440\u043E\u0431\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C, \u0431\u0435\u0437 \u043E\u043A\u0440\u0443\u0433\u043B\u0435\u043D\u0438\u044F\n\r\n\tstr()
    - \u0434\u0430\u0451\u0442 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0441\u0442\u0440\u043E\u043A\u043E\u0432\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435,
    \u0442\u043E \u0435\u0441\u0442\u044C \u043C\u043E\u0436\u043D\u043E \u043F\u0438\u0441\u0430\u0442\u044C
    \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435\n
    \r\n\tfloat() - \u043F\u043B\u0430\u0432\u0430\u044E\u0449\u0435\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435,
    \u043E\u043D\u043E \u0434\u0430\u0451\u0442 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0434\u0440\u043E\u0431\u043D\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F"
