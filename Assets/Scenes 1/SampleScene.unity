--- !u!114 &423887115
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 423887113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t1) \u041F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043C\u043E\u0433\u0443\u0442
    \u0431\u044B\u0442\u044C: \u0431\u0443\u043A\u0432\u044B \u0438 \u0446\u0438\u0444\u0440\u044B
    + \"_\", \u043D\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0439\u0442\u0435
    \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441 \u0446\u0438\u0444\u0440,
    \u043F\u0438\u0448\u0438\u0442\u0435 \u0431\u0435\u0437 \u043F\u0440\u043E\u0431\u0435\u043B\u043E\u0432
    \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u043F\u0435\u0446.
    \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432 \u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
    \"_\", \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044F \u0441 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C\u0438
    \u043A\u043E\u043C\u0430\u043D\u0434\u0430\u043C\u0438 Python.\n\n\t2) \"=\"
    - \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 \u043F\u0440\u0438\u0441\u0432\u0430\u0438\u0432\u0430\u043D\u0438\u044F
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F  \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439.\n\n\t3)
    int() - \u0442\u0438\u043F \u0434\u0430\u043D\u043D\u044B\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0432 \u0446\u0435\u043B\u043E\u0435
    \u0447\u0438\u0441\u043B\u043E, \u0447\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
    \u0432 \u0441\u043A\u043E\u0431\u043A\u0430\u0445.\n\n\t4) str() - \u0442\u0438\u043F
    \u0434\u0430\u043D\u043D\u044B\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0432 \u0441\u0442\u0440\u043E\u043A\u043E\u0432\u043E\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435, \u0447\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
    \u0432 \u0441\u043A\u043E\u0431\u043A\u0430\u0445. \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0438\u0441\u0430\u0442\u044C \u0442\u0435\u043A\u0441\u0442 \u0432 \u0441\u043A\u043E\u0431\u043A\u0430\u0445
    (\" \").\n\n\t5) float() - \u0442\u0438\u043F \u0434\u0430\u043D\u043D\u044B\u0445,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u0432 \u0434\u0440\u043E\u0431\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E,
    \u0447\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \u0432 \u0441\u043A\u043E\u0431\u043A\u0430\u0445.\n\n\t6)
    input() - \u0431\u0435\u0440\u0451\u0442 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
