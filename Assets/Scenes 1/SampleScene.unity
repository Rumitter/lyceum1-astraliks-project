    \u0438\u043B\u0438 \u0431\u0440\u0430\u043B \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E,
    \u0442\u0430\u043A \u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0442\u0438\u043F \u0434\u0430\u043D\u043D\u044B\u0445 \u0441 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439
    input() \u043D\u0430 \u043F\u0440\u0438\u043C\u0435\u0440:\n\t\n\ta = int(input())\r\n\n\t\u042D\u0442\u0430
    \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043F\u0440\u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0435
    \u043A\u043E\u0434\u0430 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0443 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F
    \u0437\u0430\u0434\u0430\u0442\u044C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0438\u043B\u0438
    \u0431\u0435\u0440\u0435\u0442 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0435\u0439 \u0434\u0430\u043D\u043D\u044B
    \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0446\u0435\u043B\u043E\u043C
    \u0438\u043B\u0438 \u043F\u043B\u0430\u0432\u0443\u044E\u0449\u0435\u043C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438
    (int(), float()). \u0412 \u0434\u0430\u043D\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435
    \u0432 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0438 \u0446\u0435\u043B\u043E\u0433\u043E
    \u0447\u0438\u0441\u043B\u0430. \u041F\u0440\u0438 \u0437\u0430\u043F\u0438\u0441\u0438
    \u043F\u0440\u043E\u0441\u0442\u043E input() \u0411\u0443\u0434\u0435\u0442 \u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0441\u0442\u0440\u043E\u043A\u043E\u0432\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435.\n\r\n\t\u041A\u043E\u043C\u0430\u043D\u0434\u0430
    print() \u043F\u0440\u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0435 \u043A\u043E\u0434\u0430
    \u0432\u044B\u0432\u0435\u0434\u0435\u0442 \u0442\u043E \u0447\u0442\u043E \u0432
    \u043D\u0435\u0451 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0438 \u0442\u0430\u043A
    \u0436\u0435 \u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u044C
    \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u043F\u0440\u0438\u043C\u0435\u0440:
    print(a) \u0432\u044B\u0432\u0435\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E
    (\u0430) \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043C\u043E\u0436\u043D\u043E
