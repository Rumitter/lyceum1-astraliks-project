  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u043F\u0435\u0440\u0432\u044B\u0439 \u0443\u0440\u043E\u043A \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435\n\u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
    \u044D\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0434\u043B\u044F
    \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u043E\u0439 \u0434\u043B\u044F \u0432
    \u043D\u0435\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438,
    \u043D\u043E \u0432\u0430\u0436\u043D\u043E\u0440 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C
    \u0443 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0439 \u0435\u0441\u0442\u044C
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430:\n1- \u043F\u0435\u0440\u0432\u043E\u0439
    \u0446\u0438\u0444\u0440\u0430 \u0431\u044B\u0442\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\n2-
    \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u043A\u0432\u044B \u0446\u0438\u0444\u0440\u044B
    \u0438 \u043D\u0436\u0438\u043D\u0435\u0435 \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u0438\u0432\u0430\u043D\u0438\u0435\n3
    - \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C
    \u0443\u0436\u0435 \u0437\u0430\u0440\u0435\u0433\u0435\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0438\u043C\u044F\n4 - \u041E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u043E
    \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439\n\u041F\u0440\u0438\u043C\u0435\u0440:
    \n\u0430 = 12 \u0438 \u0441 = 18 - \u0430\n\u0442\u043E \u0441 \u0431\u0443\u0434\u0435\u0442
    6\n= \u044D\u0442\u043E \u0437\u043D\u0430\u043A \u043F\u0440\u0438\u0441\u0432\u0430\u0438\u0432\u0430\u043D\u0438\u044F
    \u043F\u0435\u0440\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439"
